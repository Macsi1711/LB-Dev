      "parameters": {
        "jsCode": "// El archivo llega en el Webhook (campo \"archivo\" del formulario) y el tipo en el cuerpo.\nconst wh = $('Webhook').first();\nconst binary = wh.binary ?? {};\nconst key = Object.keys(binary)[0];\nconst tipo = String(wh.json.body?.tipo ?? '').toLowerCase();\nreturn [{ json: { tipo: key ? tipo : 'sin-archivo' }, binary: key ? { data: binary[key] } : {} }];\n"
      },
