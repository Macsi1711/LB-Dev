      },
      "name": "¿Usuario de la web?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [440, 300],
      "id": "d98b2bf1-7002-4e09-8bcd-9ab9110c2b20"
    },
    {
      "parameters": {
        "jsCode": "// La foto llega en el campo \"archivo\" y el código del artículo en \"codigo\".\nconst wh = $('Webhook').first();\nconst binary = wh.binary ?? {};\nconst key = Object.keys(binary)[0];\nconst codigo = String(wh.json.body?.codigo ?? '').trim();\nconst ok = Boolean(key) && codigo !== '';\n// Nombre en Drive: código + fecha, para reconocerla a mano. Sin caracteres raros.\nconst fecha = new Date().toISOString().slice(0, 16).replace(/[-:T]/g, '');\nconst limpio = codigo.replace(/[^A-Za-z0-9._-]+/g, '_');\nreturn [{\n  json: { ok, codigo, nombre: `${limpio} web ${fecha}.jpg` },\n  binary: ok ? { data: binary[key] } : {},\n}];\n"
      },
      "name": "Recuperar archivo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
